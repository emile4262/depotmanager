datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus { ACTIVE, SUSPENDED, EXPIRED }
enum UserRole { SUPER_ADMIN, OWNER, MANAGER, CASHIER, STOCK_MANAGER }
enum ProductUnit { BOTTLE, PACK, CRATE }
enum SaleStatus { COMPLETED, CREDIT, PARTIAL, CANCELLED }
enum PaymentMethod { CASH, WAVE, ORANGE_MONEY, MTN_MONEY, MOOV_MONEY, BANK_TRANSFER }

model Tenant {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  phone        String
  email        String?
  status       TenantStatus      @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  TenantMembership[]
  depots       Depot[]
  products     Product[]
  customers    Customer[]
  sales        Sale[]
  subscription Subscription?
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  fullName     String
  phone        String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  TenantMembership[]
}

model TenantMembership {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      UserRole  @default(CASHIER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([userId, tenantId])
}

model Depot {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  isMain       Boolean           @default(false)
  stocks       StockBalance[]
  sales        Sale[]
}

model Product {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  brand          String?
  category       String
  volumeMl       Int
  unitType       ProductUnit    @default(BOTTLE)
  unitFactor     Int            @default(1)
  purchasePrice  Decimal        @db.Decimal(10, 2)
  salePrice      Decimal        @db.Decimal(10, 2)
  alertThreshold Int            @default(5)
  isActive       Boolean        @default(true)
  stocks         StockBalance[]
  saleLines      SaleLine[]
}

model StockBalance {
  id        String   @id @default(uuid())
  depotId   String
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  @@unique([depotId, productId])
}

model Customer {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  creditLimit   Decimal          @default(0) @db.Decimal(10, 2)
  currentCredit Decimal          @default(0) @db.Decimal(10, 2)
  cratesDue     Int              @default(0)
  sales         Sale[]
}

model Sale {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  depotId       String
  depot         Depot          @relation(fields: [depotId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  totalAmount   Decimal        @db.Decimal(10, 2)
  paidAmount    Decimal        @db.Decimal(10, 2)
  status        SaleStatus     @default(COMPLETED)
  paymentMethod PaymentMethod  @default(CASH)
  createdAt     DateTime       @default(now())
  lines         SaleLine[]
}

model SaleLine {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  totalLine Decimal @db.Decimal(10, 2)
}

model Subscription {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      String   // STARTER, PRO, BUSINESS
  status    String   // ACTIVE, TRIAL, EXPIRED
  startDate DateTime @default(now())
  endDate   DateTime
}
